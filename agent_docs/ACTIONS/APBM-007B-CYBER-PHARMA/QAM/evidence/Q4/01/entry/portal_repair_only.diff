+  quantity: 2, quantityUpdates: [] as number[], pay: 0, void: 0,
+};
+const mockInvoice = () => ({ id: 'in_unit', customer: 'cus_unit', currency: 'usd', status: mockS.inv.status, amount_due: mockS.inv.amount, total: mockS.inv.amount,
