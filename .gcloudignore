# Cloud Build upload boundary — generated by next-deploy-auto v1.3 (references/UPLOAD_BOUNDARY.md)
# This file governs what `gcloud builds submit` uploads. Its presence disables automatic
# .gitignore mirroring, so .gitignore is included explicitly below.
.gcloudignore
.git
.git/**
#!include:.gitignore
node_modules/
.next/
**/.env*
.env*
**/*.pem
**/*.p12
**/*.key
**/*service*account*.json
**/*credentials*.json
.auth/
**/.auth/**
test-results/
playwright-report/
blob-report/
agent_docs/
_SKILLS/
# Playwright specs: not a build input (next build only needs src/ + config).
e2e/
