# cyph-stripe-subscription-portal-v1 — environment template (placeholders only)
# Copy to .env.local (gitignored). Values here are NOT real.
# Only variables the retained app actually reads are listed as REQUIRED.

# ---------- REQUIRED (read by src/utils/supabase/*, src/proxy.ts) ----------
# Intended connection for the FFM: the SHARED Cyber Pharma dev Supabase project
# (same project the Mission Control FFM used; "CyberPharma_Dev_v1" label in the
# operator's .env.local). Confirm with the operator before pointing elsewhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ---------- OPTIONAL ----------
# Used only to decide the `secure` cookie flag (https → secure). Defaults to "".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Read ONLY by src/utils/supabase/admin.ts (service-role client). That module
# has no consumers today; leave unset for the FFM.
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# ---------- NOT USED YET (reserved for the billing phase; NOT required for the FFM) ----------
# No code reads these today. Do not add real values for mock-data work.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_STARTER=price_replace_me
# STRIPE_PRICE_PRO=price_replace_me
# STRIPE_PRICE_ENTERPRISE=price_replace_me

# ---------- Mail guard and customer-facing contact/legal (APBM-007B; amended 20 Nov 2026) ----------
# Exact recipients allowed to receive billing notices (comma-separated). Empty = nobody. "*" is ignored.
# MAIL_ALLOWLIST=owner@example.com
# allowlist (default) | open. "open" is honoured ONLY on the DEV/alpha Supabase project yrsuwikjnbmvpznrgydb.
# MAIL_RECIPIENT_POLICY=allowlist
# Support address (default: the contract-recorded support@pharmacybooks.com; mailbox operation unverified).
# NEXT_PUBLIC_SUPPORT_EMAIL=
# Director-supplied legal destinations (https only). Until set, pages say "(link not yet published)". Required before
# any external exposure (STAGING_AND_GATE_D.md).
# NEXT_PUBLIC_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=
